# Optional local database path. The application uses this file by default.
DATABASE_URL=file:./cicd-pate.db

# Generate independent random values for each environment. Do not reuse them.
# PowerShell example: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SSH_SECRET=replace-with-a-random-32-byte-secret
ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key

# Required API authentication. Use unique high-entropy values per environment.
CICD_ADMIN_USERNAME=replace-with-an-admin-username
CICD_ADMIN_PASSWORD=replace-with-a-long-random-password
CICD_API_TOKEN=replace-with-a-long-random-api-token

# Optional when the UI and API are served from different origins.
NEXT_PUBLIC_API_BASE=
